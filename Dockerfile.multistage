# Multi-stage build: compiles Rust binary from source in Alpine
FROM rust:alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY frontend/ ./frontend/
COPY src/ ./src/

RUN cargo build --release

# Final minimal runtime
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /app/target/release/docklite /usr/local/bin/docklite

ENV PORT=3000
ENV HOST=0.0.0.0
ENV RUST_LOG=docklite=info

EXPOSE 3000

CMD ["docklite"]
